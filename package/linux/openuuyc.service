# 与 src/platform/linux/host_service.rs 的 unit_body 保持一致。
[Unit]
Description=OpenUUYC 远程被控
PartOf=graphical-session.target
After=graphical-session.target xdg-desktop-portal.service
ConditionFileIsExecutable=/usr/bin/openuuyc
StartLimitIntervalSec=500
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/openuuyc gui --background
Restart=on-failure
RestartSec=5
KillMode=process

[Install]
WantedBy=graphical-session.target
